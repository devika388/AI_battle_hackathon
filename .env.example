# Express API
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Frontend API base path; Vite proxies this path to the Express API in development.
VITE_API_BASE_URL=/api
VITE_PUBLIC_CONTACT_EMAIL=

# Supabase public project settings. The anon/publishable key is safe for browser use
# only when Row Level Security is enabled for every exposed table.
VITE_SUPABASE_URL=https://vwajfollrydxcawvskta.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend-only Supabase settings. Never expose the service-role key to the frontend.
SUPABASE_URL=https://vwajfollrydxcawvskta.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
